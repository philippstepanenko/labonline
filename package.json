{
  "name": "labonline",
  "version": "0.1.0",
  "private": true,
  "description": "Сетевая игра «Побег из лабиринта»",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vendor:three": "mkdir -p public/vendor && cp node_modules/three/build/three.module.min.js public/vendor/three.module.min.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "three": "^0.169.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
